{
  "name": "@docqa/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "eval": "tsx --env-file=../../.env src/eval/run.ts",
    "seed": "tsx --env-file=../../.env src/db/seed.ts"
  },
  "dependencies": {
    "@docqa/shared": "workspace:*",
    "@docqa/storage": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
