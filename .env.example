# API service
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (Neon) — must have pgvector extension available
DATABASE_URL=postgres://user:pass@host/docqa

# Redis (Upstash) — BullMQ, rate limiting, cache
REDIS_URL=rediss://default:pass@host:6379

# Embeddings + completions
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Worker
WORKER_CONCURRENCY=2

# Object storage (Tigris/S3) — leave unset to use local disk (DATA_DIR)
# BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
DATA_DIR=./data

# GitHub OAuth (Auth.js)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET=
